# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR CLOUD (DOCKER COMPOSE)
# ==============================================================================

# Domínio ou IP público do servidor
# Exemplo com domínio: api.meurastreio.com
# Exemplo local/IP: localhost
DOMAIN=localhost

# E-mail para emissão automática do certificado SSL Let's Encrypt / ZeroSSL
ACME_EMAIL=admin@rastreio.local

# Ambiente e Logs
ENVIRONMENT=production
DEBUG=false
APP_NAME=IoT Asset Tracking Platform

# Segredo JWT para assinar os tokens do App Android e Web
JWT_SECRET=super_secret_jwt_cloud_key_2026_prod_token_rastreio_secure
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Banco de Dados PostgreSQL + PostGIS + TimescaleDB
POSTGRES_DB=tracking
POSTGRES_USER=tracking
POSTGRES_PASSWORD=tracking_cloud_pwd_2026
DATABASE_URL=postgresql+asyncpg://tracking:tracking_cloud_pwd_2026@postgres:5432/tracking

# Cache & PubSub Redis
REDIS_URL=redis://redis:6379/0

# Streaming Kafka (opcional)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_LOCATION_TOPIC=iot.location-events

# Notificações SMS (para login OTP)
SMS_PROVIDER=dev
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Retenção de dados (dias)
DATA_RETENTION_DAYS=365

