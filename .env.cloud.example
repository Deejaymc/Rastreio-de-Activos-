# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR CLOUD (DOCKER COMPOSE)
# ==============================================================================

# Domínio público ou subdomínio apontado para a VPS (ex: api.rastreio.com ou rastreio.meudominio.com)
# Caso não tenha domínio ainda, pode colocar o IP público da VPS: DOMAIN=http://203.0.113.10
DOMAIN=api.rastreio.com

# E-mail para emissão automática do certificado SSL gratuito Let's Encrypt / ZeroSSL
ACME_EMAIL=admin@rastreio.com

# Ambiente e Logs
ENVIRONMENT=production
DEBUG=false
APP_NAME=IoT Asset Tracking Platform

# Segredo JWT (Gere uma chave segura e longa com: openssl rand -hex 32)
JWT_SECRET=mude-este-segredo-super-secreto-para-producao-cloud-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Banco de Dados PostgreSQL + PostGIS + TimescaleDB
POSTGRES_DB=tracking
POSTGRES_USER=tracking
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui_123!
DATABASE_URL=postgresql+asyncpg://tracking:defina_uma_senha_forte_aqui_123!@postgres:5432/tracking

# Cache & PubSub Redis
REDIS_URL=redis://redis:6379/0

# Streaming Kafka (opcional)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_LOCATION_TOPIC=iot.location-events

# Notificações SMS (para login OTP)
SMS_PROVIDER=dev
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Retenção de dados (dias)
DATA_RETENTION_DAYS=365

