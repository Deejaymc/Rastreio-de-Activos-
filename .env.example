# Configurações Gerais da Aplicação
APP_NAME=IoT Asset Tracking Platform
ENVIRONMENT=development  # development | staging | production
DEBUG=false

# Banco de Dados
# Desenvolvimento local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./tracking.db
# Staging / Produção (PostgreSQL com PostGIS e TimescaleDB):
# DATABASE_URL=postgresql+asyncpg://tracking:tracking@localhost:5432/tracking

# Cache & Pub/Sub
REDIS_URL=redis://localhost:6379/0

# Streaming Kafka (opcional para altíssima escala de ingestão IoT)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_LOCATION_TOPIC=iot.location-events

# Broker MQTT (para dispositivos de telemetria veicular/rastreadores industriais)
MQTT_ENABLED=true
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=iot/locations/#

# Autenticação e Segurança (JWT)
JWT_SECRET=sua-chave-secreta-forte-alterar-em-producao-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200  # 30 dias

# Provedor de SMS para Validação de Telefone (OTP)
SMS_PROVIDER=dev  # dev (exibe nos logs) | twilio | infobip
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Mapas e Geolocalização
MAPBOX_ACCESS_TOKEN=
DATA_RETENTION_DAYS=365
